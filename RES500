    tk.Entry.pack = lambda self, *args, **kwargs: tk.Entry.pack_(self, *args, **kwargs) if 'height' not in kwargs else [self.configure(font=(self.cget('font')[0], kwargs.pop('height')//2)), tk.Entry.pack_(self, *args, **kwargs)]
    app = ScienceSimulatorApp(root)
    root.mainloop()
